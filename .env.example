# Server
PORT=3456
# Workspace directory (Claude CWD, file tree, terminals). Defaults to server directory if unset.
# WORKSPACE=/path/to/your/project
# Default permission mode when client does not send one (e.g. bypassPermissions = allow all for testing)
DEFAULT_PERMISSION_MODE=bypassPermissions
# AI Provider: "claude", "gemini", or "codex"
DEFAULT_PROVIDER=codex
# Codex: profile name from ~/.codex/config.toml [profiles.<name>]. When set, codex exec runs with --profile <name> (overrides project profile).
# When unset, codex uses instructions from <workspace>/profile/ (instructions.md or AGENTS.md). See repo profile/ directory.
# CODEX_PROFILE=vibe-coding
# Gemini approval mode (default, auto_edit, plan)
DEFAULT_GEMINI_APPROVAL_MODE=auto_edit
# Claude output log directory. Log files are named claude-output-<timestamp>.log; one per server run.
# Defaults to <project-root>/logs (directory containing server.js) when unset.
# CLAUDE_OUTPUT_LOG=/path/to/logs

# Mock Claude: replay a log file instead of spawning the real CLI (for testing UI without API).
# MOCK_CLAUDE=1
# MOCK_CLAUDE=1 → app shows sequence picker; pick in UI or set:
# MOCK_CLAUDE_SEQUENCE=ask-two-questions-purpose-style
# MOCK_CLAUDE_LOG=/path/to/custom.log
# MOCK_CLAUDE_DELAY_MS=80
# MOCK_CLAUDE_EXIT_DELAY_MS=60000  (ms before emitting exit; keeps AskUserQuestion modal open until then, or until user confirms/cancels)

# Mobile (Expo) - optional override for default permission in app
# EXPO_PUBLIC_DEFAULT_PERMISSION_MODE=bypassPermissions
# EXPO_PUBLIC_SERVER_URL=http://YOUR_SERVER_IP:3456
