# Server
PORT=3456
# Default permission mode when client does not send one (e.g. bypassPermissions = allow all for testing)
DEFAULT_PERMISSION_MODE=bypassPermissions

# Mobile (Expo) - optional override for default permission in app
# EXPO_PUBLIC_DEFAULT_PERMISSION_MODE=bypassPermissions
# EXPO_PUBLIC_SERVER_URL=http://YOUR_SERVER_IP:3456
